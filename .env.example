# ---- docker compose variables --------------------------------------------
# Copy to `.env` and fill in before `docker compose up`.
# See backend/.env.example for field-by-field documentation.

# Stellar network: testnet | mainnet
NETWORK=testnet

# The deployed GridPulse contract id (required).
CONTRACT_ID=

# Secret key of the funded relayer account (required).
RELAYER_SECRET=

# Optional operator/admin secret key (enables /api/admin/* endpoints).
ADMIN_SECRET=

# Where the browser can reach the backend API. Defaults to localhost:4000.
# Only change this if the backend is exposed on a different host.
NEXT_PUBLIC_API_URL=http://localhost:4000
