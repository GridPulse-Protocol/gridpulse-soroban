{
  "name": "@gridpulse/backend",
  "version": "0.1.0",
  "private": true,
  "description": "GridPulse relayer + REST API: relays signed IoT meter readings to Soroban and serves grid state.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@noble/ed25519": "^2.1.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
