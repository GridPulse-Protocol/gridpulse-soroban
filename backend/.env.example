# ---- Network ---------------------------------------------------------------
# NETWORK selects a preset RPC/passphrase. One of: testnet | mainnet.
# Override individually with RPC_URL and NETWORK_PASSPHRASE if you use a
# self-hosted RPC or a custom network.
NETWORK=testnet
# RPC_URL=https://soroban-testnet.stellar.org
# NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---- Contract ---------------------------------------------------------------
# The deployed GridPulse contract id.
CONTRACT_ID=

# ---- Relayer ----------------------------------------------------------------
# Secret key of the account that signs and funds `submit_reading`/`settle`
# transactions. Must be funded on the target network.
RELAYER_SECRET=

# ---- Operator (admin) -------------------------------------------------------
# Optional. Secret key of the grid operator account configured as the contract's
# `admin`. Required to use the /api/admin/* endpoints (register meters, set
# price/fee). Leave blank to disable admin endpoints.
ADMIN_SECRET=

# ---- Scheduler --------------------------------------------------------------
# Run the background batch-flush + settle jobs. Disable to operate the relayer
# manually through POST /api/flush and POST /api/settle.
SCHEDULER_ENABLED=true

# How often (seconds) to drain queued readings to the chain.
BATCH_INTERVAL_SECONDS=15

# Max readings submitted per flush.
BATCH_SIZE=50

# Close a settlement window automatically on a fixed cadence.
AUTO_SETTLE=true
SETTLE_INTERVAL_SECONDS=300

# ---- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=4000

# Directory for the local meter registry + reading queue (JSON).
DATA_DIR=./data
